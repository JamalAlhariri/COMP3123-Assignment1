{
  "info": {
    "name": "COMP3123 Assignment 1 - Complete API Tests",
    "description": "Import this collection into Postman. Run requests in numbered order after the API and MongoDB are working. Run the rate-limit demo separately after changing AUTH_RATE_LIMIT_MAX to 5 and restarting the server. Never export real JWTs or credentials to a public repository.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Start here",
      "item": [
        {
          "name": "01 Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Server is running\", () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test(\"Helmet security header\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Create users",
      "item": [
        {
          "name": "02 Signup User A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/user/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userA}}\",\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{passwordA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set(\"userA\", \"demoa_\" + stamp);",
                  "pm.collectionVariables.set(\"emailA\", \"demoa_\" + stamp + \"@example.com\");",
                  "pm.collectionVariables.set(\"passwordA\", \"DemoPass123!\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
